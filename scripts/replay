#!/usr/bin/env bash
set -euo pipefail
project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$project_dir"
if [[ $# == 0 ]]; then
  exec python3 "$project_dir/scripts/open_replay.py"
fi
if [[ $1 == open ]]; then
  shift
  exec python3 "$project_dir/scripts/open_replay.py" "$@"
fi
if [[ $1 == desktop-entry ]]; then
  shift
  exec python3 "$project_dir/scripts/open_replay.py" --print-desktop-entry "$@"
fi
if [[ ${1:-} == build ]]; then
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
  cmake --build build -j 2
  exit
fi
if [[ ! -x build/replay ]]; then
  "$0" build >&2
fi
export OMP_THREAD_LIMIT=1
exec ./build/replay "$@"
